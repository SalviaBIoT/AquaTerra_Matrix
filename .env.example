# ==============================================================================
# AquaTerra Matrix — Variables de Entorno de Ejemplo (copiar a `.env`)
# NUNCA subas tu archivo `.env` real con credenciales a GitHub.
# ==============================================================================

# --- Motor IA Híbrida (Mandarino IA Studio) ---
# Proveedor preferido: auto | gemini | ollama | local_reglas
AQUATERRA_IA_PROVEEDOR=auto

# Google Gemini AI Studio (obtén tu clave en https://aistudio.google.com/apikey)
GEMINI_API_KEY=
AQUATERRA_GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama Local (ejecución privada/offline en GPU o CPU)
AQUATERRA_OLLAMA_URL=http://127.0.0.1:11434
AQUATERRA_OLLAMA_MODEL=qwen2.5:3b
AQUATERRA_OLLAMA_TIMEOUT=90.0

# --- Conectores IoT y Alertas (opcionales) ---
UBIDOTS_TOKEN=
N8N_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Base de datos SQLite local (opcional; por defecto data/runtime/aquaterra.db) ---
# AQUATERRA_DB=
